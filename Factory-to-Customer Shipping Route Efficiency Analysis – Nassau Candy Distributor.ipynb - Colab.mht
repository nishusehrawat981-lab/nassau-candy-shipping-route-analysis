      <pre class="editor flex monaco monaco-colorized colab-dark colab-dark" contenteditable="true" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Cell&nbsp;7:&nbsp;Overall&nbsp;Key&nbsp;Performance&nbsp;Indicators</span></span><br><span><span></span></span><br><span><span class="mtk1">total_shipments&nbsp;=&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">df</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">avg_cost&nbsp;=&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Shipping_Cost_USD"</span><span class="mtk14">]</span><span class="mtk1">.mean</span><span class="mtk14">()</span></span><br><span><span class="mtk1">median_cost&nbsp;=&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Shipping_Cost_USD"</span><span class="mtk14">]</span><span class="mtk1">.median</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">avg_transit&nbsp;=&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Actual_Transit_Hours"</span><span class="mtk14">]</span><span class="mtk1">.mean</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">on_time_rate&nbsp;=&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"On_Time_Delivery"</span><span class="mtk14">]</span><span class="mtk1">.eq</span><span class="mtk14">(</span><span class="mtk5">"Yes"</span><span class="mtk14">)</span><span class="mtk1">.mean</span><span class="mtk14">()</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk6">100</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">damage_count&nbsp;=&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Shipment_Damaged"</span><span class="mtk14">]</span><span class="mtk1">.eq</span><span class="mtk14">(</span><span class="mtk5">"Yes"</span><span class="mtk14">)</span><span class="mtk1">.</span><span class="mtk17">sum</span><span class="mtk14">()</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">damage_rate&nbsp;=&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Shipment_Damaged"</span><span class="mtk14">]</span><span class="mtk1">.eq</span><span class="mtk14">(</span><span class="mtk5">"Yes"</span><span class="mtk14">)</span><span class="mtk1">.mean</span><span class="mtk14">()</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk6">100</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">delayed_count&nbsp;=&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df</span><span class="mtk14">[</span><span class="mtk5">"Delay_Hours"</span><span class="mtk14">]</span><span class="mtk1">.fillna</span><span class="mtk14">(</span><span class="mtk6">0</span><span class="mtk14">)</span><span class="mtk1">.gt</span><span class="mtk14">(</span><span class="mtk6">0</span><span class="mtk14">)</span><span class="mtk1">.</span><span class="mtk17">sum</span><span class="mtk14">()</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">kpi_summary&nbsp;=&nbsp;pd.DataFrame</span><span class="mtk14">({</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"KPI"</span><span class="mtk14">:</span><span class="mtk1"> </span><span class="mtk14">[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Total&nbsp;Shipments"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Average&nbsp;Shipping&nbsp;Cost&nbsp;(USD)"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Median&nbsp;Shipping&nbsp;Cost&nbsp;(USD)"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Average&nbsp;Transit&nbsp;Time&nbsp;(Hours)"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"On-Time&nbsp;Delivery&nbsp;Rate&nbsp;(%)"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Delayed&nbsp;Shipments"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Damaged&nbsp;Shipments"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Damage&nbsp;Rate&nbsp;(%)"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk14">],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"Value"</span><span class="mtk14">:</span><span class="mtk1"> </span><span class="mtk14">[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;total_shipments</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">round</span><span class="mtk14">(</span><span class="mtk1">avg_cost</span><span class="mtk14">,</span><span class="mtk1"> </span><span class="mtk6">2</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">round</span><span class="mtk14">(</span><span class="mtk1">median_cost</span><span class="mtk14">,</span><span class="mtk1"> </span><span class="mtk6">2</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">round</span><span class="mtk14">(</span><span class="mtk1">avg_transit</span><span class="mtk14">,</span><span class="mtk1"> </span><span class="mtk6">2</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">round</span><span class="mtk14">(</span><span class="mtk1">on_time_rate</span><span class="mtk14">,</span><span class="mtk1"> </span><span class="mtk6">2</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;delayed_count</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;damage_count</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">round</span><span class="mtk14">(</span><span class="mtk1">damage_rate</span><span class="mtk14">,</span><span class="mtk1"> </span><span class="mtk6">2</span><span class="mtk14">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk14">]</span></span><br><span><span class="mtk14">})</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Overall&nbsp;KPI&nbsp;Summary:"</span><span class="mtk14">)</span></span><br><span><span class="mtk1">display</span><span class="mtk14">(</span><span class="mtk1">kpi_summary</span><span class="mtk14">)</span></span><br></pre><colab-form class="formview vertical layout flex"><div c